# ============================================================
# Copy this file to `.env` and fill in your own values.
# NEVER commit the real `.env` file.
# ============================================================

# Neon PostgreSQL
# Use the pooled connection string (host has -pooler) for runtime,
# and the direct connection string for DIRECT_URL / migrations.
# Use sslmode=verify-full to match the current default and silence
# the pg-connection-string deprecation warning.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=verify-full"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=verify-full"

# Secret used to sign the admin session JWT.
# Generate one with:  openssl rand -base64 32
AUTH_SECRET=""

# Public absolute URL of the site (used for canonical/OG/sitemap).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Admin account created by `npx prisma db seed`
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""

# Vercel Blob (image storage). Get from https://vercel.com > Storage > Blob
BLOB_READ_WRITE_TOKEN=""